# Set these in the terminal or in a private environment file; never commit credentials.
ISAACLAB_ROOT=/home/YOUR_USER/IsaacLab
ISAAC_PYTHON=/home/YOUR_USER/miniconda3/envs/isaaclab232/bin/python
# Python import path to YOUR real held-out evaluation function
RL_EVAL_FUNCTION=your_project.eval:evaluate_policy
