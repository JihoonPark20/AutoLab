{
  "name": "isaaclab_go2_or_humanoid_example",
  "research_goal": "Increase held-out locomotion success without increasing fall rate or energy, using training MDP changes only",
  "backend": "claude",
  "training_mode": "cold_start",
  "claude_model": "sonnet",
  "agent_timeout_seconds": 240,
  "max_cycles": 10,
  "max_changed_parameters": 2,
  "poll_seconds": 5,
  "training_seed_base": 40,
  "train_seeds": [
    40,
    41,
    42
  ],
  "parameters": {
    "curriculum_difficulty": {
      "value": 0.2,
      "min": 0.0,
      "max": 1.0,
      "max_delta": 0.15
    },
    "reward_tracking": {
      "value": 1.0,
      "min": 0.5,
      "max": 2.0,
      "max_delta": 0.2
    }
  },
  "train": {
    "command": [
      "{python}",
      "{autolab_root}/scripts/isaac_train.py",
      "--run-dir",
      "{run_dir}",
      "--params-json",
      "{params_json}",
      "--seed",
      "{seed}",
      "--resume-checkpoint",
      "{resume_checkpoint}",
      "--task",
      "YOUR_REGISTERED_TASK_ID",
      "--map-json",
      "{autolab_root}/configs/hydra_map.example.json",
      "--num-envs",
      "4096",
      "--max-iterations",
      "10000"
    ],
    "timeout_seconds": 21600,
    "early_stop": {
      "enabled": false,
      "metric": "train_success",
      "patience_points": 20,
      "min_points": 50,
      "min_delta": 0.001
    }
  },
  "eval": {
    "command": [
      "{python}",
      "{autolab_root}/scripts/isaac_eval_contract.py",
      "--run-dir",
      "{run_dir}",
      "--checkpoint",
      "{checkpoint}",
      "--task",
      "YOUR_REGISTERED_TASK_ID",
      "--fixed-seeds",
      "{fixed_seeds}"
    ],
    "timeout_seconds": 1800,
    "fixed_seeds": [
      501,
      502,
      503,
      504,
      505
    ]
  },
  "decision": {
    "primary_metric": "success_rate",
    "maximize": true,
    "target_score": 0.85,
    "min_improvement": 0.02,
    "guardrails": {
      "fall_rate": {
        "max": 0.12
      },
      "energy": {
        "max": 1.5
      }
    }
  },
  "limits": {
    "max_calls_24h": 2,
    "max_calls_7d": 6,
    "min_seconds_between_calls": 1800,
    "max_consecutive_failures": 2
  },
  "project": {
    "root": "${ISAACLAB_ROOT}",
    "python": "auto",
    "enforce_external_runs": true,
    "git_guard": false
  }
}
